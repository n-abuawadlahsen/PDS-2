# Inventario cerrado de configuracion (SPEC 14 S14.6). Ningun valor real va
# aqui (S14.6.1.3): solo los nombres. Copiar a `.env` para desarrollo local
# (ese `.env` esta en .gitignore y nunca se sube).

# --- No secretos (S14.6.3) ---
ENTORNO=local
PERFIL_ALCANCE=parcial
CANVAS_MODO=doble
CANVAS_BASE_URL=
CANVAS_INSTANCIAS=
GITHUB_MODO=doble
# Solo obligatoria si ENTORNO=ensayo (guarda de S14.4: ensayo no arranca si
# coincide con la de produccion).
CANVAS_BASE_URL_PRODUCCION_REFERENCIA=
COMUNICACIONES_SALIENTES=pausadas
DESTINATARIOS_PERMITIDOS=
EMAIL_FROM=
EMAIL_FROM_NOMBRE=
EMAIL_REPLY_TO=
EMAIL_DOMINIO_VERIFICADO=
# Para correo real: resend, con dominio verificado y clave configurada.
# Fuera de produccion siempre se usa el adaptador de consola.
EMAIL_PROVEEDOR=sin_configurar
VITE_API_BASE_URL=
FRONTEND_ORIGEN=
COOKIE_DOMINIO=
APP_VERSION=dev

# --- Secretos: inventario cerrado de 15 (S14.6.2) ---
DATABASE_URL=
APP_ENCRYPTION_KEYS=
APP_ENCRYPTION_KEY_ACTIVA=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET_ANTERIOR=
EMAIL_PROVIDER_API_KEY=
SIGNING_KEY=
SIGNING_KEY_ANTERIOR=
GITHUB_ENSAYO_APP_ID=
GITHUB_ENSAYO_APP_PRIVATE_KEY=
CANVAS_TOKEN_DEMO=
